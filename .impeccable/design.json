      },
      {
        "name": "The Red Means Recording Rule",
        "body": "Красный — только запись.",
        "section": "colors"
      },
      {
        "name": "The No Kicker Rule",
        "body": "Над заголовком ничего не пишется; дата, шаг и фокус идут строкой под ним.",
        "section": "typography"
      },
      {
        "name": "The No Border Rule",
        "body": "У групп нет рамок и теней; рамка — только состояние.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do держать одну чёрную кнопку главного действия на экран.",
      "Do набирать все цифры с tabular-nums и единицей рядом серым.",
      "Do оставлять красный только за записью, синий — за ссылками и данными.",
      "Do писать дату, шаг и фокус строкой под заголовком."
    ],
    "donts": [
      "Don't ставить эйбрау или кикер над заголовком.",
      "Don't выстраивать одинаковые карточки в сетку и ряды статистики.",
      "Don't добавлять группам рамки или тени.",
      "Don't использовать теги-пилюли для метаданных.",
      "Don't вводить второй шрифт, в том числе моноширинный для цифр."
